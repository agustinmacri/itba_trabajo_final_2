# Copiar a .env (cp .env.example .env) y cambiar las contraseñas.

# Usuario dueño de la base: carga los datos y sirve para explorar.
POSTGRES_USER=olist
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=olist

# Usuario del agente: solo lee olist y escribe en app (sin DELETE ni DROP).
AGENT_DB_USER=agent
AGENT_DB_PASSWORD=cambiar_esto_tambien

# Dónde está la base:
#   el agente corre en tu máquina   -> localhost y POSTGRES_PORT
#   el agente corre dentro de Docker -> db y 5432
POSTGRES_HOST=localhost
# Puerto en tu máquina. Si ya tenés un Postgres local en 5432, usá otro (ej. 5433).
POSTGRES_PORT=5432
